      {
        "sequence": [
          {
            "request": {
              "id": "r1",
              "path": "/t/echo",
              "query": {
                "v": 1
              },
              "options": {
                "key": true,
                "cache": {
                  "ttl_ms": 5000,
                  "key": "fixed"
                }
              }
            }
          },
          {
            "request": {
              "id": "r2",
              "path": "/t/echo",
              "query": {
                "v": 2
              },
              "options": {
