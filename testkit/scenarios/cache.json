  {
    "id": "cache.diff-body-no-mixup",
    "title": "不同请求体不串 key",
    "why": "key:deep 把 body 纳入哈希，否则不同 body 会互相命中",
    "requires": [
      "cache",
      "key"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "key": {},
        "cache": {
          "ttl_ms": 5000,
          "methods": [
            "GET",
            "PUT"
          ]
        }
      }
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "method": "PUT",
              "body": {
                "v": 1
              },
              "options": {
                "key": "deep",
                "cache": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "method": "PUT",
              "body": {
                "v": 2
              },
              "options": {
                "key": "deep",
                "cache": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true,
            "data": {
              "request": {
                "body": {
                  "json": {
                    "v": 1
                  }
                }
              }
            }
          },
          "b": {
            "ok": true,
            "data": {
              "request": {
                "body": {
                  "json": {
                    "v": 2
                  }
                }
              }
            }
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
