  {
    "id": "cache.user-scope-no-leak",
    "title": "切换用户不串缓存",
    "why": "缓存 key 并入用户标识：u2 不能读到 u1 的缓存",
    "requires": [
      "cache",
      "key",
      "auth"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "auth": {
          "url_pattern": "/t/private",
          "refresh": "endpoint"
        },
        "key": {
          "scope": "user"
        },
        "cache": {
          "ttl_ms": 5000
        }
      }
    },
    "steps": [
      {
        "login": {
          "user": "u1"
        }
      },
      {
        "request": {
          "id": "a1",
          "path": "/t/private/me",
          "options": {
            "key": true,
            "cache": true
          }
        }
      },
      {
        "request": {
          "id": "a2",
          "path": "/t/private/me",
          "options": {
            "key": true,
            "cache": true
          }
        }
      },
      {
        "logout": {}
      },
      {
        "login": {
          "user": "u2"
        }
      },
      {
        "request": {
          "id": "b1",
          "path": "/t/private/me",
          "options": {
            "key": true,
            "cache": true
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a1": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u1"
              }
            }
          },
          "a2": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u1"
              }
            },
            "from_cache": true
          },
          "b1": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u2"
              }
            },
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/private/me": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "a1": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u1"
              }
            }
          },
          "a2": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u1"
              }
            },
            "from_cache": true
          },
          "b1": {
            "ok": true,
            "data": {
              "meta": {
                "auth": "u2"
              }
            },
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/private/me": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
