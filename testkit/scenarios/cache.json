[
  {
    "id": "cache.hit-no-server",
    "title": "命中缓存不到服务器",
    "why": "缓存命中必须在客户端短路，服务端只看到一次",
    "requires": [
      "cache",
      "key"
    ],
    "networks": [
      "normal",
      "weak",
      "offline",
      "dns",
      "blackhole"
    ],
    "client": {
      "plugins": {
        "key": {},
        "cache": {
          "ttl_ms": 5000
        }
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "r1",
              "path": "/t/echo",
              "options": {
                "key": true,
                "cache": true
              }
            }
          },
          {
            "request": {
              "id": "r2",
              "path": "/t/echo",
              "options": {
                "key": true,
                "cache": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 1
          },
          "r2": {
            "ok": true,
            "hit": 1,
            "from_cache": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 1
          },
          "r2": {
            "ok": true,
            "hit": 1,
            "from_cache": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          },
          "r2": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          },
          "r2": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          },
          "r2": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "cache.ttl-expiry",
    "title": "TTL 过期后重新请求",
    "why": "过期缓存不能继续返回旧数据",
    "requires": [
      "cache",
      "key"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "key": {},
        "cache": {
          "ttl_ms": 800
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "options": {
            "key": true,
            "cache": true
          }
        }
      },
      {
        "wait": 1200
      },
      {
        "request": {
          "id": "r2",
          "path": "/t/echo",
          "options": {
            "key": true,
            "cache": true
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 1
          },
          "r2": {
            "ok": true,
            "hit": 2,
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 1
          },
          "r2": {
            "ok": true,
            "hit": 2,
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
