      "retry",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak",
      "lossy"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 3,
          "delay_ms": 100,
          "methods": [
            "GET",
            "POST"
          ]
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fail_times": 2
          },
          "method": "POST",
          "body": {
            "id": 7,
            "tags": [
              "a",
              "b"
            ],
            "note": "你好"
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 3,
            "data": {
              "request": {
                "method": "POST",
                "body": {
                  "json": {
                    "id": 7,
                    "tags": [
                      "a",
                      "b"
                    ],
                    "note": "你好"
                  }
                }
              }
            }
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 3,
            "data": {
              "request": {
                "method": "POST",
                "body": {
                  "json": {
                    "id": 7,
                    "tags": [
                      "a",
                      "b"
                    ],
                    "note": "你好"
                  }
                }
              }
            }
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "lossy": {
        "results": {
          "r1": {
            "ok": true,
            "data": {
              "request": {
                "method": "POST",
                "body": {
                  "json": {
                    "id": 7,
                    "tags": [
                      "a",
                      "b"
                    ],
                    "note": "你好"
                  }
                }
              }
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
