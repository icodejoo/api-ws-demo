          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "retry.post-opt-in-body-intact",
    "title": "POST 显式允许重试且请求体一致",
