          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 4
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "retry.4xx-no-retry",
    "title": "4xx 不重试",
    "why": "客户端错误重试没有意义，只会放大流量",
    "requires": [
      "retry",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 3,
          "delay_ms": 100
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "status": 400,
                "key": "a"
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "status": 404,
                "key": "b"
              }
            }
          },
          {
            "request": {
              "id": "c",
              "path": "/t/echo",
              "query": {
                "status": 422,
                "key": "c"
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": false,
            "error": "status:400"
          },
          "b": {
            "ok": false,
            "error": "status:404"
          },
          "c": {
            "ok": false,
            "error": "status:422"
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "a": {
            "ok": false,
            "error": "status:400"
          },
          "b": {
            "ok": false,
            "error": "status:404"
          },
          "c": {
            "ok": false,
            "error": "status:422"
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
