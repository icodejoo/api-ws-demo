[
  {
    "id": "retry.500-then-ok",
    "title": "前两次 500 后恢复",
    "why": "最基本的重试成功路径",
    "requires": [
      "retry",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak",
      "lossy"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 3,
          "delay_ms": 100
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fail_times": 2
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 3
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 3
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "lossy": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
