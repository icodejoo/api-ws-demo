  {
    "id": "retry.503-retry-after",
    "title": "遵守 Retry-After",
    "why": "Retry-After 优先于自身退避，防止过早重打服务端",
    "requires": [
      "retry",
      "normalize"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 3,
          "delay_ms": 100,
          "respect_retry_after": true
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fail_times": 1,
            "fail_status": 503,
            "retry_after": 1
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "hit": 2
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "duration_ms": {
          "min": 900
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "retry.post-default-no-retry",
    "title": "POST 默认不重试",
    "why": "非幂等请求默认重试会造成重复提交",
