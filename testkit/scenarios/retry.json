      "retry",
      "normalize"
    ],
    "networks": [
      "normal",
      "offline"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 3,
          "delay_ms": 100
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fail_times": 1
          },
          "method": "POST",
          "body": {
            "a": 1
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "status:500"
          }
        },
