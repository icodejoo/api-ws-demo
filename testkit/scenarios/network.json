[
  {
    "id": "network.offline-immediate",
    "title": "断网立即以 network 失败",
    "why": "拒绝连接要快速失败，loading 关闭，服务端 0 请求",
    "requires": [
      "loading"
    ],
    "networks": [
      "offline",
      "dns"
    ],
    "client": {
      "plugins": {
        "loading": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "duration_ms": {
          "max": 5000
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "duration_ms": {
          "max": 5000
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "network.offline-all-methods",
    "title": "断网下各方法一致失败",
    "why": "不同方法的失败分类一致",
