  {
    "id": "network.blackhole-timeout",
    "title": "黑洞靠超时发现",
    "why": "连得上但不回包，只能靠超时；不应无限等待",
    "requires": [
      "log"
    ],
    "networks": [
      "blackhole"
    ],
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "options": {
            "timeout_ms": 1500
          }
        }
      }
    ],
    "expect": {
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "duration_ms": {
          "min": 1300,
          "max": 8000
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000,
    "client": {
      "base_timeout_ms": 4000
    }
  },
