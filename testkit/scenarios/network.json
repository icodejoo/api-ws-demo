  {
    "id": "network.blackhole-cancel-all",
    "title": "黑洞下 cancel_all 立即生效",
    "why": "用户取消不必等超时",
    "requires": [
      "cancel"
    ],
    "networks": [
      "blackhole"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "fire": {
          "request": {
            "id": "a",
            "path": "/t/echo",
            "query": {
              "key": "a"
            }
          }
        }
      },
      {
        "fire": {
          "request": {
            "id": "b",
            "path": "/t/echo",
            "query": {
              "key": "b"
            }
          }
        }
      },
      {
        "cancel_all": {
          "after_ms": 600
        }
      },
      {
        "wait": 300
      }
    ],
    "expect": {
      "blackhole": {
        "results": {
          "a": {
            "ok": false,
            "error": "canceled"
          },
          "b": {
            "ok": false,
            "error": "canceled"
          }
        },
        "duration_ms": {
          "max": 3000
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "network.flap-no-retry",
    "title": "断网窗口内失败、恢复后成功",
    "why": "前 1.5s 断网，连接预算 500ms：首个请求在恢复前以 network 或 timeout 结束，2s 后请求成功；避免系统 TCP 重试跨过恢复窗口",
    "requires": [
      "log",
      "timeout"
    ],
    "networks": [
      "flap"
    ],
    "client": {
      "plugins": {
        "log": {},
        "timeout": {
          "connect_ms": 500,
          "receive_ms": 4000
        }
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      },
      {
        "wait": 2000
      },
      {
        "request": {
          "id": "r2",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "flap": {
        "results": {
          "r1": {
            "ok": false,
            "error": [
              "network",
              "timeout"
            ]
          },
          "r2": {
            "ok": true
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "network.flap-retry-recovers",
    "title": "flap + retry 恢复",
    "why": "断网窗口内的请求靠重试在恢复后成功，loading 一对、无通知",
    "requires": [
      "retry",
      "loading",
      "notify"
    ],
    "networks": [
      "flap",
      "normal"
    ],
    "client": {
      "plugins": {
        "retry": {
          "max": 6,
          "delay_ms": 500
        },
        "loading": {},
        "notify": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "flap": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "notify": {
            "eq": 0
          },
          "pending_after": {
            "eq": 0
          }
        }
      },
      "normal": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "notify": {
            "eq": 0
          },
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
