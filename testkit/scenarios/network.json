      "dns"
    ],
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "g",
              "path": "/t/echo",
              "method": "GET"
            }
          },
          {
            "request": {
              "id": "po",
              "path": "/t/echo",
              "method": "POST",
              "body": {
                "a": 1
              }
            }
          },
          {
            "request": {
              "id": "pu",
              "path": "/t/echo",
              "method": "PUT",
              "body": {
                "a": 1
              }
            }
          },
          {
            "request": {
              "id": "d",
              "path": "/t/echo",
              "method": "DELETE"
            }
          }
        ]
      }
    ],
    "expect": {
      "offline": {
        "results": {
          "g": {
            "ok": false,
            "error": "network"
          },
          "po": {
            "ok": false,
            "error": "network"
          },
          "pu": {
            "ok": false,
            "error": "network"
          },
          "d": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "g": {
            "ok": false,
            "error": "network"
          },
          "po": {
            "ok": false,
            "error": "network"
          },
          "pu": {
            "ok": false,
            "error": "network"
          },
          "d": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
