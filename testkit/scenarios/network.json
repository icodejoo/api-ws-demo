          "id": "a",
          "path": "/t/echo"
        }
      },
      {
        "network": "offline"
      },
      {
        "request": {
          "id": "b",
          "path": "/t/echo",
          "query": {
            "key": "b"
          }
        }
      },
      {
        "network": "normal"
      },
      {
        "request": {
          "id": "c",
          "path": "/t/echo",
          "query": {
            "key": "c"
          }
        }
