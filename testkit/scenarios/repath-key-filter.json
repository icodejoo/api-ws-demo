[
  {
    "id": "repath.basic",
    "title": "路径变量替换",
    "why": "{id} 要被替换成参数值",
    "requires": [
      "repath"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "repath": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/public/pet/{id}",
          "query": {
            "id": 5
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
