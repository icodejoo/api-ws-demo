  {
    "id": "repath.key-after-repath",
    "title": "repath 先于 key",
    "why": "用替换后的路径算 key：id=5 与 id=6 不能共享",
    "requires": [
      "repath",
      "key",
      "share"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "repath": {},
        "key": {},
        "share": {
          "policy": "start"
        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/public/pet/{id}",
              "query": {
                "id": 5,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/public/pet/{id}",
              "query": {
                "id": 6,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            }
          },
          "b": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/6"
              }
            }
          }
        },
        "server": {
          "by_path": {
            "/t/public/pet/5": {
              "eq": 1
            },
            "/t/public/pet/6": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "repath.key-cache-no-mixup",
    "title": "repath + key + cache 不串",
    "why": "id=5 缓存命中；id=6 必须是新请求",
    "requires": [
      "repath",
      "key",
      "cache"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "repath": {},
        "key": {},
        "cache": {
          "ttl_ms": 5000
        }
      }
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "a1",
              "path": "/t/public/pet/{id}",
              "query": {
                "id": 5
              },
              "options": {
                "key": true,
                "cache": true
              }
            }
          },
          {
            "request": {
              "id": "a2",
              "path": "/t/public/pet/{id}",
              "query": {
                "id": 5
              },
              "options": {
                "key": true,
                "cache": true
              }
            }
          },
          {
            "request": {
              "id": "b1",
              "path": "/t/public/pet/{id}",
              "query": {
                "id": 6
              },
              "options": {
                "key": true,
                "cache": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            }
          },
          "a2": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            },
            "from_cache": true
          },
          "b1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/6"
              }
            },
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/public/pet/5": {
              "eq": 1
            },
            "/t/public/pet/6": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "a1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            }
          },
          "a2": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/5"
              }
            },
            "from_cache": true
          },
          "b1": {
            "ok": true,
            "data": {
              "request": {
                "path": "/t/public/pet/6"
              }
            },
            "from_cache": false
          }
        },
        "server": {
          "by_path": {
            "/t/public/pet/5": {
              "eq": 1
            },
            "/t/public/pet/6": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  }
]
