  {
    "id": "key.share-diff-query-not-merged",
    "title": "查询不同不合并",
    "why": "key 包含查询参数",
    "requires": [
      "key",
      "share"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "key": {},
        "share": {
          "policy": "start"
        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "q": 1,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "q": 2,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true
          },
          "b": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "key.query-order-insensitive",
    "title": "查询参数顺序不影响 key",
    "why": "{a,b} 与 {b,a} 是同一个请求",
    "requires": [
      "key",
      "share"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "key": {},
        "share": {
          "policy": "start"
        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "a": 1,
                "b": 2,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "b": 2,
                "a": 1,
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true
          },
          "b": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "key.body-diff-not-merged",
    "title": "请求体不同不合并",
    "why": "key:deep 把 body 纳入",
    "requires": [
      "key",
      "share"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "key": {},
        "share": {
          "policy": "start"
        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "delay_ms": 300
              },
              "method": "PUT",
              "body": {
                "v": 1
              },
              "options": {
                "key": "deep",
                "share": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "delay_ms": 300
              },
              "method": "PUT",
              "body": {
                "v": 2
              },
              "options": {
                "key": "deep",
                "share": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true,
            "data": {
              "request": {
                "body": {
                  "json": {
                    "v": 1
                  }
                }
              }
            }
          },
          "b": {
            "ok": true,
            "data": {
              "request": {
                "body": {
                  "json": {
                    "v": 2
                  }
                }
              }
            }
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 2
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
