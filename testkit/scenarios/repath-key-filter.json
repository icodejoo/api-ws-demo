        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "q": "x",
                "page": "",
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "q": "x",
                "delay_ms": 300
              },
              "options": {
                "key": true,
                "share": true
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": true
          },
          "b": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
