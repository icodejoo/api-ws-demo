[
  {
    "id": "cancel.single",
    "title": "单个请求取消",
    "why": "取消要真的掐断连接，服务端能观察到 aborted",
    "requires": [
      "cancel"
    ],
    "networks": [
      "normal",
      "weak",
      "offline",
      "dns",
      "blackhole"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "delay_ms": 5000
          },
          "cancel_after_ms": 1500
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "canceled"
          }
        },
        "server": {
          "aborted": {
            "min": 1
          }
        },
        "duration_ms": {
          "max": 4000
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": false,
            "error": "canceled"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": [
              "network",
              "canceled"
            ]
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "canceled"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "cancel.hang-is-canceled-not-timeout",
    "title": "挂起的请求被取消归为 canceled",
    "why": "主动取消不能被误报成 timeout",
    "requires": [
      "cancel"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "hang"
          },
          "cancel_after_ms": 1200
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "canceled"
          }
        },
        "server": {
          "aborted": {
            "min": 1
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "cancel.all",
    "title": "cancel_all 取消全部在途请求",
    "why": "一次取消所有在途",
    "requires": [
      "cancel"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      }
    },
    "steps": [
      {
        "fire": {
          "request": {
            "id": "a",
            "path": "/t/echo",
            "query": {
              "delay_ms": 5000,
              "key": "a"
            }
          }
        }
      },
      {
        "fire": {
          "request": {
            "id": "b",
            "path": "/t/echo",
            "query": {
              "delay_ms": 5000,
              "key": "b"
            }
          }
        }
      },
      {
        "fire": {
          "request": {
            "id": "c",
            "path": "/t/echo",
            "query": {
              "delay_ms": 5000,
              "key": "c"
            }
          }
        }
      },
      {
        "cancel_all": {
          "after_ms": 1500
        }
      },
      {
        "wait": 600
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": false,
            "error": "canceled"
          },
          "b": {
            "ok": false,
            "error": "canceled"
          },
          "c": {
            "ok": false,
            "error": "canceled"
          }
        },
        "server": {
          "aborted": {
            "min": 3
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "cancel.all-then-new-works",
    "title": "cancel_all 之后新请求正常",
    "why": "取消不是永久的",
    "requires": [
      "cancel"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      }
    },
    "steps": [
      {
        "fire": {
          "request": {
            "id": "a",
            "path": "/t/echo",
            "query": {
              "delay_ms": 5000,
              "key": "a"
            }
          }
        }
      },
      {
        "cancel_all": {
          "after_ms": 800
        }
      },
      {
        "wait": 1500
      },
      {
        "request": {
          "id": "b",
          "path": "/t/echo",
          "query": {
            "key": "b"
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": false,
            "error": "canceled"
          },
          "b": {
            "ok": true
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "cancel.one-of-many",
    "title": "只取消其中一个",
    "why": "取消不影响同时在途的其他请求",
    "requires": [
      "cancel"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "cancel": {}
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "r1",
              "path": "/t/echo",
              "query": {
                "delay_ms": 2500,
                "key": "a"
              }
            }
          },
          {
            "request": {
              "id": "r2",
              "path": "/t/echo",
              "query": {
                "delay_ms": 2500,
                "key": "b"
              },
              "cancel_after_ms": 1000
            }
          },
          {
            "request": {
              "id": "r3",
              "path": "/t/echo",
              "query": {
                "delay_ms": 2500,
                "key": "c"
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true
          },
          "r2": {
            "ok": false,
            "error": "canceled"
          },
          "r3": {
            "ok": true
          }
        },
        "server": {
          "aborted": {
            "eq": 1
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
