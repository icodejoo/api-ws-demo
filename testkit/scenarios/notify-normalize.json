      "normal"
    ],
    "client": {
      "plugins": {
        "notify": {},
        "normalize": {}
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "r0",
              "path": "/t/echo",
              "query": {
                "status": 500,
                "key": "k0"
              }
            }
          },
          {
            "request": {
              "id": "r1",
              "path": "/t/echo",
              "query": {
                "status": 500,
                "key": "k1"
              }
            }
          },
          {
            "request": {
              "id": "r2",
              "path": "/t/echo",
              "query": {
                "status": 500,
                "key": "k2"
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r0": {
            "ok": false,
            "error": "status:500"
          },
          "r1": {
            "ok": false,
            "error": "status:500"
          },
          "r2": {
            "ok": false,
            "error": "status:500"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 3
          }
        }
      }
    }
  },
