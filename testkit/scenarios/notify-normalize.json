[
  {
    "id": "notify.http-error-once",
    "title": "HTTP 失败只通知一次",
    "why": "一次失败一个提示，不能重复弹",
    "requires": [
      "notify",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak",
      "offline",
      "dns",
      "blackhole"
    ],
    "client": {
      "plugins": {
        "notify": {},
        "normalize": {}
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "status": 500
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "status:500"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 1
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": false,
            "error": "status:500"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 1
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 1
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 1
          }
        }
      },
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "notify": {
            "eq": 1
          }
        }
      }
    },
    "timeout_ms": 40000
  },
