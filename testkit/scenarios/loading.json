      "loading",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "loading": {},
        "normalize": {}
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "status": 500
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "status:500"
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": false,
            "error": "status:500"
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
