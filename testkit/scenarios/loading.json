[
  {
    "id": "loading.single-pair",
    "title": "单个请求一对 show/hide",
    "why": "基础契约",
    "requires": [
      "loading"
    ],
    "networks": [
      "normal",
      "weak",
      "offline",
      "dns",
      "blackhole"
    ],
    "client": {
      "plugins": {
        "loading": {}
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "client": {
          "loading": [
            true,
            false
          ],
          "pending_after": {
            "eq": 0
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "loading": [
            true,
            false
          ]
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "loading": [
            true,
            false
          ]
        }
      },
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          },
          "loading": [
            true,
            false
          ]
        }
      }
    },
    "timeout_ms": 40000
  },
