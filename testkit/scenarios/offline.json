[
  {
    "id": "offline.probe-fails-fast",
    "title": "探测判无网直接 offline 错误",
    "why": "无网时不发业务请求，直接报 offline",
    "requires": [
      "offline"
    ],
    "networks": [
      "offline",
      "dns",
      "blackhole"
    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        }
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "offline"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "offline"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "offline"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "offline.online-passes",
    "title": "在线时放行",
    "why": "有网时探测不应拦截业务请求",
    "requires": [
      "offline"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "offline.recovers-after-online",
    "title": "恢复在线后放行",
    "why": "恢复网络后探测通过，请求成功",
    "requires": [
      "offline"
    ],
    "networks": [
      "offline"
    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "a",
          "path": "/t/echo"
        }
      },
      {
        "network": "normal"
      },
      {
        "request": {
          "id": "b",
          "path": "/t/echo",
          "query": {
            "key": "b"
          }
        }
      }
    ],
    "expect": {
      "offline": {
        "results": {
          "a": {
            "ok": false,
            "error": "offline"
