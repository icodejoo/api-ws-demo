                "key": "k2"
              }
            }
          },
          {
            "request": {
              "id": "r3",
              "path": "/t/echo",
              "query": {
                "key": "k3"
              }
            }
          },
          {
            "request": {
              "id": "r4",
              "path": "/t/echo",
              "query": {
                "key": "k4"
              }
            }
          }
        ]
      }
