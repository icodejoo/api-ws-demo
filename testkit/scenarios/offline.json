    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "a",
          "path": "/t/echo"
        }
      },
      {
        "wait": 2000
      },
      {
        "request": {
          "id": "b",
          "path": "/t/echo",
          "query": {
            "key": "b"
          }
        }
      }
    ],
    "expect": {
      "flap": {
        "results": {
          "a": {
            "ok": false,
            "error": "offline"
          },
          "b": {
            "ok": true
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
