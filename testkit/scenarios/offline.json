        "server": {
          "total": {
            "eq": 1
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "offline.flap-recovers",
    "title": "断网窗口内 offline，恢复后成功",
    "why": "flap 恢复后的请求不能还被判离线",
