  {
    "id": "offline.cache-hit-still-served",
    "title": "缓存命中不受离线影响",
    "why": "缓存在离线判定之前短路：断网读缓存仍成功",
    "requires": [
      "offline",
      "cache",
      "key"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        },
        "key": {},
        "cache": {
          "ttl_ms": 5000
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "options": {
            "key": true,
            "cache": true
          }
        }
      },
      {
        "network": "offline"
      },
      {
        "request": {
          "id": "r2",
          "path": "/t/echo",
          "options": {
            "key": true,
            "cache": true
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true
          },
          "r2": {
            "ok": true,
            "from_cache": true
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "offline.cancel-while-probing",
    "title": "探测期间取消",
    "why": "黑洞下探测卡住，用户取消应立即生效",
    "requires": [
      "offline",
      "cancel"
    ],
    "networks": [
      "blackhole"
    ],
    "client": {
      "plugins": {
        "offline": {
          "probe": "/t/ping"
        },
        "cancel": {}
      },
      "base_timeout_ms": 4000
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "cancel_after_ms": 600
        }
      }
    ],
    "expect": {
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "canceled"
          }
        },
        "duration_ms": {
          "max": 3000
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
