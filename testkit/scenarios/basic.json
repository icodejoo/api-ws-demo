[
  {
    "id": "basic.get-ok",
    "title": "最简 GET 成功",
    "why": "客户端装好插件后，普通请求仍要原样成功",
    "requires": [
      "log"
    ],
    "networks": [
      "normal",
      "weak",
      "offline",
      "dns",
      "blackhole"
    ],
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "data": "{\"a\":1}"
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": true,
            "data": {
              "payload": {
                "a": 1
              }
            },
            "hit": 1
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": true,
            "data": {
              "payload": {
                "a": 1
              }
            },
            "hit": 1
          }
        },
        "server": {
          "by_path": {
            "/t/echo": {
              "eq": 1
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "offline": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "dns": {
        "results": {
          "r1": {
            "ok": false,
            "error": "network"
          }
        },
        "server": {
          "total": {
            "eq": 0
