[
  {
    "id": "timeout.total-hang",
    "title": "总超时：hang 到点即超时",
    "why": "total_ms 是硬上限",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "total_ms": 800
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "hang"
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "duration_ms": {
          "min": 700,
          "max": 4000
        },
        "server": {
          "aborted": {
            "min": 1
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "timeout.receive-slow-body",
    "title": "接收超时：块间隔过大",
    "why": "数据停顿超过 receive_ms 即超时",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "receive_ms": 300
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "slow_body",
            "size": 8000,
            "chunk_bytes": 1024,
            "chunk_ms": 700
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "timeout.receive-ok-fast-chunks",
