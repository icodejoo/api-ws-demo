          }
        }
      }
    }
  },
  {
    "id": "timeout.total-over-slow-chunks",
    "title": "总超时覆盖慢吐 body",
    "why": "size=20000、chunk_bytes=1024（约 20 块）×400ms：每块间隔都没超过 receive_ms，但总时长远超 total_ms，仍应超时",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "receive_ms": 1500,
          "total_ms": 1000
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "slow_body",
            "size": 20000,
            "chunk_bytes": 1024,
            "chunk_ms": 400
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "timeout.connect-blackhole",
    "title": "连接超时：黑洞",
    "why": "connect_ms 先于默认超时触发",
    "requires": [
      "timeout"
    ],
    "networks": [
      "blackhole"
    ],
    "client": {
      "base_timeout_ms": 10000,
      "plugins": {
        "timeout": {
          "connect_ms": 800
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo"
        }
      }
    ],
    "expect": {
      "blackhole": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "total": {
            "eq": 0
          }
        },
        "duration_ms": {
          "min": 700,
          "max": 3500
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "timeout.request-override-shorter",
    "title": "请求级超时更短",
    "why": "请求自己的 timeout_ms 能收紧",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "total_ms": 5000
        }
      }
    },
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "delay_ms": 1500
          },
          "options": {
            "timeout_ms": 500
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
