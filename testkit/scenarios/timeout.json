  {
    "id": "timeout.recovers-after-timeout",
    "title": "超时之后客户端仍正常",
    "why": "一次超时不能让后续请求也超时",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "total_ms": 700
        }
      }
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "a",
              "path": "/t/echo",
              "query": {
                "fault": "hang",
                "key": "a"
              }
            }
          },
          {
            "request": {
              "id": "b",
              "path": "/t/echo",
              "query": {
                "key": "b"
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "a": {
            "ok": false,
            "error": "timeout"
          },
          "b": {
            "ok": true
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
    "id": "timeout.parallel-all-timeout",
    "title": "并发超时并行计时",
    "why": "5 个并发超时总耗时不应叠加",
    "requires": [
      "timeout"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "timeout": {
          "total_ms": 500
        }
      }
    },
    "steps": [
      {
        "parallel": [
          {
            "request": {
              "id": "r0",
              "path": "/t/echo",
              "query": {
                "delay_ms": 4000,
                "key": "k0"
              }
            }
          },
          {
            "request": {
              "id": "r1",
              "path": "/t/echo",
              "query": {
                "delay_ms": 4000,
                "key": "k1"
              }
            }
          },
          {
            "request": {
              "id": "r2",
              "path": "/t/echo",
              "query": {
                "delay_ms": 4000,
                "key": "k2"
              }
            }
          },
          {
            "request": {
              "id": "r3",
              "path": "/t/echo",
              "query": {
                "delay_ms": 4000,
                "key": "k3"
              }
            }
          },
          {
            "request": {
              "id": "r4",
              "path": "/t/echo",
              "query": {
                "delay_ms": 4000,
                "key": "k4"
              }
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r0": {
            "ok": false,
            "error": "timeout"
          },
          "r1": {
            "ok": false,
            "error": "timeout"
          },
          "r2": {
            "ok": false,
            "error": "timeout"
          },
          "r3": {
            "ok": false,
            "error": "timeout"
          },
          "r4": {
            "ok": false,
            "error": "timeout"
          }
        },
        "duration_ms": {
          "max": 3000
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
