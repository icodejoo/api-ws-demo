      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "slow_body",
            "size": 3000,
            "chunk_bytes": 1024,
            "chunk_ms": 50
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
