[
  {
    "id": "faults.hang-timeout",
    "title": "hang 归为 timeout 并掐断连接",
    "why": "挂起请求必须靠超时发现，且服务端看到 aborted",
    "requires": [
      "log"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "steps": [
      {
        "request": {
          "id": "r1",
          "path": "/t/echo",
          "query": {
            "fault": "hang"
          },
          "options": {
            "timeout_ms": 800
          }
        }
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "server": {
          "aborted": {
            "min": 1
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "r1": {
            "ok": false,
            "error": "timeout"
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
