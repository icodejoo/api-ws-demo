[
  {
    "id": "breaker.open-after-threshold",
    "title": "连续失败后熔断，快速失败不打服务端",
    "why": "熔断打开后请求必须不触网",
    "requires": [
      "breaker",
      "normalize"
    ],
    "networks": [
      "normal",
      "weak"
    ],
    "client": {
      "plugins": {
        "breaker": {
          "threshold": 3,
          "open_ms": 1000
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "f1",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "f2",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "f3",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "r4",
              "path": "/t/public/bk"
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "f1": {
            "ok": false,
            "error": "status:500"
          },
          "f2": {
            "ok": false,
            "error": "status:500"
          },
          "f3": {
            "ok": false,
            "error": "status:500"
          },
          "r4": {
            "ok": false,
            "error": "breaker_open"
          }
        },
        "server": {
          "by_path": {
            "/t/public/bk": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      },
      "weak": {
        "results": {
          "f1": {
            "ok": false,
            "error": "status:500"
          },
          "f2": {
            "ok": false,
            "error": "status:500"
          },
          "f3": {
            "ok": false,
            "error": "status:500"
          },
          "r4": {
            "ok": false,
            "error": "breaker_open"
          }
        },
        "server": {
          "by_path": {
            "/t/public/bk": {
              "eq": 3
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    },
    "timeout_ms": 40000
  },
  {
    "id": "breaker.half-open-recovers",
    "title": "open_ms 后半开探测成功则恢复",
    "why": "熔断不能永久：冷却后放探测请求，成功即关闭",
    "requires": [
      "breaker",
      "normalize"
    ],
    "networks": [
      "normal"
    ],
    "client": {
      "plugins": {
        "breaker": {
          "threshold": 3,
          "open_ms": 1000
        },
        "normalize": {}
      }
    },
    "steps": [
      {
        "sequence": [
          {
            "request": {
              "id": "f1",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "f2",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "f3",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "blocked",
              "path": "/t/public/bk"
            }
          },
          {
            "wait": 1300
          },
          {
            "request": {
              "id": "probe",
              "path": "/t/public/bk"
            }
          },
          {
            "request": {
              "id": "after",
              "path": "/t/public/bk"
            }
          }
        ]
      }
    ],
    "expect": {
      "normal": {
        "results": {
          "blocked": {
            "ok": false,
            "error": "breaker_open"
          },
          "probe": {
            "ok": true
          },
          "after": {
            "ok": true
          }
        },
        "server": {
          "by_path": {
            "/t/public/bk": {
              "eq": 5
            }
          }
        },
        "client": {
          "pending_after": {
            "eq": 0
          }
        }
      }
    }
  },
  {
