          {
            "request": {
              "id": "f3",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "wait": 1300
          },
          {
            "request": {
              "id": "probe",
              "path": "/t/public/bk",
              "query": {
                "status": 500
              }
            }
          },
          {
            "request": {
              "id": "blocked",
              "path": "/t/public/bk"
            }
          },
          {
            "wait": 1300
